VITE_API_BASE_URL=http://localhost:3000

# Discord bot's Application/Client ID (from https://discord.com/developers/applications),
# used to build the "Add to Discord" invite link on the Discord Bot page. Not a secret.
# VITE_DISCORD_CLIENT_ID=

# Base URL of Explv's Map (../Explv-s-map), embedded via <ExplvMap> (src/components/ExplvMap.tsx).
# Defaults to the same value if unset — only needed if you run it on a different port. 3003 is
# that repo's own vite.config.js default (3002 is already Ardy-Host-URL-shortener's port).
VITE_EXPLV_MAP_URL=http://localhost:3003

# Base URL of the dax-path pathfinder API (https://github.com/dQw4w9WgXcQ/osrs-pathfinder),
# used by src/api/pathfinder.ts to build paths for <ExplvMap paths={...} />. Defaults to the
# same value if unset — only needed if you run it on a different port.
VITE_PATHFINDER_URL=http://localhost:3004
